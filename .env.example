# Gemma 4 / Google Gemini API credentials
# Set your API key below for live model extraction
GEMMA_API_KEY=your_gemini_api_key_here

# Model identifier for Google Gemma 4 multimodal understanding
# Supported instruction-tuned multimodal models:
#   - gemma-4-31b-it (Default: 31B dense multimodal model)
#   - gemma-4-26b-a4b-it (26B MoE multimodal model)
#   - gemma-4-4b-it (Lightweight edge multimodal model)
GEMMA_MODEL_NAME=gemma-4-31b-it

# Optional: Set to 1 to force mock/demo mode for deterministic offline hackathon testing
FORCE_MOCK_GEMMA=0
