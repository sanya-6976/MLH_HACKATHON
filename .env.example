# Gemma 4 / Google Gemini API credentials
# Set your API key below for live model extraction
GEMMA_API_KEY=your_gemini_api_key_here

# Model identifier for Gemma 4 multimodal understanding
# Default: gemma-4
GEMMA_MODEL_NAME=gemma-4

# Optional: Set to 1 to force mock/demo mode for deterministic offline hackathon testing
FORCE_MOCK_GEMMA=0
